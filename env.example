# Copy this file to .env and fill in your values. Never commit .env.

# Base URL of the Memos API.
# Memos 0.30 / 0.31 use .../api/v1 ; Memos 26.10+ uses .../api
MEMOS_API_URL=https://memos.example.com/api/v1

# Personal access token from Memos user settings (starts with memos_pat_)
MEMOS_TOKEN=memos_pat_replace_me

# Tag applied to every upload and used to find existing clippings
CLIPPING_TAG=clippings

# PRIVATE, PROTECTED or PUBLIC
MEMO_VISIBILITY=PRIVATE

# Defaults, relative paths are resolved from the script's folder
CLIPPINGS_PATH=Kindle Clippings.txt
PREVIEW_PATH=upload_preview.md
